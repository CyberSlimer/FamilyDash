# Family Dashboard Configuration
# Edit these settings to customize your dashboard

# ============================================================================
# DISPLAY SETTINGS
# ============================================================================

# Screen rotation interval (seconds)
SCREEN_ROTATION_INTERVAL=30

# Motion sensor timeout (seconds) - display sleeps after this period of no motion
MOTION_TIMEOUT=300

# Default screen to show on wake (0-3)
DEFAULT_SCREEN=0

# ============================================================================
# LOCATION SETTINGS
# ============================================================================

# Location for weather
LOCATION_NAME="Rochester, NY"
LOCATION_LAT=43.1566
LOCATION_LON=-77.6088

# Temperature unit (F or C)
TEMPERATURE_UNIT=F

# ============================================================================
# HARDWARE SETTINGS
# ============================================================================

# GPIO pin assignments (BCM numbering)
BUTTON_PIN=17
MOTION_PIN=27

# Button debounce time (milliseconds)
BUTTON_DEBOUNCE=300

# ============================================================================
# API SETTINGS
# ============================================================================

# Backend API port
API_PORT=5000

# API host (use 0.0.0.0 to allow network access)
API_HOST=0.0.0.0

# ============================================================================
# CALENDAR SETTINGS
# ============================================================================

# Calendars are defined in config/calendars.json (copy calendars.example.json).
# Any number of CalDAV (iCloud, Nextcloud...) and ICS/webcal feeds are supported.
CALENDARS_FILE=config/calendars.json

# Secrets referenced from calendars.json as ${ICLOUD_USERNAME} etc.
# iCloud: use your Apple ID + an app-specific password from appleid.apple.com
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# How often to re-fetch calendars (seconds) and how far ahead to cache (days)
CALENDAR_REFRESH_INTERVAL=300
CALENDAR_LOOKAHEAD_DAYS=14

# Timezone for displaying events (IANA name). Leave blank to use the system zone.
TIMEZONE=America/New_York

# --- Legacy single-calendar fallback (only used if calendars.json is missing) ---
# CALENDAR_TYPE=caldav|ical
CALENDAR_TYPE=local
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
ICAL_URL=

# ============================================================================
# MEAL PLANNING
# ============================================================================

# Default meal types
MEAL_TYPES=breakfast,lunch,dinner,snack

# Grocery list categories
GROCERY_CATEGORIES=produce,dairy,meat,bakery,pantry,frozen,other

# Pantry locations
PANTRY_LOCATIONS=pantry,fridge,freezer

# Days to warn before pantry item expiration
EXPIRATION_WARNING_DAYS=7

# ============================================================================
# RECIPE IMPORT
# ============================================================================

# User agent for recipe scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Timeout for recipe import (seconds)
RECIPE_IMPORT_TIMEOUT=10

# ============================================================================
# DISPLAY CUSTOMIZATION
# ============================================================================

# Color scheme (gradient start)
COLOR_PRIMARY=#667eea

# Color scheme (gradient end)
COLOR_SECONDARY=#764ba2

# Font family
FONT_FAMILY=-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif

# ============================================================================
# LOGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable debug mode (true/false)
DEBUG_MODE=false

# ============================================================================
# BACKUP
# ============================================================================

# Auto-backup database (true/false)
AUTO_BACKUP=true

# Backup interval (days)
BACKUP_INTERVAL=7

# Number of backups to keep
BACKUP_RETENTION=4

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Enable web interface authentication (true/false)
ENABLE_AUTH=false

# Web interface username (if auth enabled)
WEB_USERNAME=admin

# Web interface password (if auth enabled)
WEB_PASSWORD=changeme

# Enable HTTPS (true/false)
ENABLE_HTTPS=false

# SSL certificate path (if HTTPS enabled)
SSL_CERT_PATH=/etc/ssl/certs/dashboard.crt
SSL_KEY_PATH=/etc/ssl/private/dashboard.key

# ============================================================================
# NOTES
# ============================================================================
# 
# After changing these settings:
# 1. Run: ./apply-config.sh
# 2. Or manually restart services:
#    sudo systemctl restart dashboard-backend
#    sudo systemctl restart dashboard-hardware
#
# Some changes (like colors) require editing HTML/CSS directly
# See README.md for detailed customization instructions
#
