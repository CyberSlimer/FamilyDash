[Unit]
Description=Family Calendar Dashboard - Calendar Sync Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/var/www/html
ExecStart=/usr/bin/python3 /var/www/html/calendar-sync.py
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
