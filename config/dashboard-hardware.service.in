[Unit]
Description=Family Dashboard Hardware Controller
# The controller polls /api/display, so it needs the backend, not the network.
After=dashboard-backend.service
Wants=dashboard-backend.service

[Service]
Type=simple
# Without this Python buffers stdout whenever it is not a terminal,
# so print() output never reaches the journal and the service looks
# silent even while it is working.
Environment=PYTHONUNBUFFERED=1
User=@@RUN_USER@@
WorkingDirectory=@@APP_DIR@@/hardware
ExecStart=@@PYTHON@@ @@APP_DIR@@/hardware/controller.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
