[Unit]
Description=Family Dashboard Backend API
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/family-dashboard/backend
ExecStart=/usr/bin/python3 /home/pi/family-dashboard/backend/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
